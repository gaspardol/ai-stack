{
  "manifest_version": 3,
  "name": "AI Stack",
  "version": "1.0.0",
  "description": "Writing assistant and automatic meeting notes, powered by your Claude subscription.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage", "sidePanel", "notifications", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Stack",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/writing.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*", "https://*.zoom.us/*", "https://whereby.com/*", "https://*.webex.com/*",
        "https://app.slack.com/*", "https://discord.com/*", "https://meet.jit.si/*", "https://*.around.co/*",
        "https://app.gather.town/*", "https://riverside.fm/*", "https://app.chime.aws/*"
      ],
      "js": ["content/meeting-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*", "https://*.zoom.us/*", "https://whereby.com/*", "https://*.webex.com/*",
        "https://app.slack.com/*", "https://discord.com/*", "https://meet.jit.si/*", "https://*.around.co/*",
        "https://app.gather.town/*", "https://riverside.fm/*", "https://app.chime.aws/*"
      ],
      "js": ["content/meeting-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
